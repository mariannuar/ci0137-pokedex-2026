<%#===========================================================================agregar.ejs — el formulario para crear un
  Pokémon, en su propia página. Hace POST a /pokemon; el controlador lo agrega al modelo y redirige a la lista. (Aquí se
  ve el enrutamiento por método: esta página es GET, el envío es
  POST.)===========================================================================%>
  <%- include('parciales/header', { titulo, paginaActual: 'pokedex' , }) %>

    <main>
      <h1>Agregar un Pokémon</h1>
      <p><a href="/">&larr; Volver a la lista</a></p>

      <%# method="POST" : por eso express.urlencoded deja los campos en peticion.body. Cada input tiene un name: esa es
        la llave con la que llega al servidor. %>
        <form action="/pokemon" method="POST">
          <fieldset>
            <legend>Datos del Pokémon</legend>

            <label for="id">Número (id)</label>
            <input type="number" id="id" name="id" required>

            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" required>

            <label for="slug">Slug (para la imagen: assets/slug.png)</label>
            <input type="text" id="slug" name="slug" placeholder="pikachu">

            <label for="tipos">Tipos (separados por coma)</label>
            <input type="text" id="tipos" name="tipos" placeholder="fuego, volador">

            <label for="descripcion">Descripción</label>
            <input type="text" id="descripcion" name="descripcion">

            <button type="submit" class="boton boton--rojo">Agregar</button>
          </fieldset>
        </form>
    </main>

    <%- include('parciales/footer') %>