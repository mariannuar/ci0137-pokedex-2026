<%#===========================================================================detalle.ejs — reemplaza detalle.html.
  Antes ficha.js leía el ?id=y armaba todo en el navegador; ahora el servidor hace lo mismo con las plantillas. Mismas
  clases e ids que generaba ficha.js. Recibe: pokemon (o null), vecinos, lectura, contador, y los helpers mayus /
  numeroPokedex / totalStats.===========================================================================%>
  <%- include('parciales/header', { titulo, paginaActual: 'pokedex' , contador, }) %>

    <main>

      <%# El carrusel: dos antes, el actual y dos después (lo calculó el controlador). %>
        <nav id="carrusel">
          <h2>Pokémon cercanos</h2>
          <ul class="carrusel">
            <% vecinos.forEach((v)=> { %>
              <% if (v.activo) { %>
                <li class="carrusel__item carrusel__item--activo" data-pos="<%= v.pos %>">
                  <img src="/assets/pokeball.svg"
                    alt="Estás viendo <%= numeroPokedex(v.pokemon.id) %> <%= v.pokemon.nombre %>" width="40"
                    height="40">
                </li>
                <% } else { %>
                  <li class="carrusel__item" data-pos="<%= v.pos %>">
                    <a href="/pokemon/<%= v.pokemon.id %>"><img src="/assets/pokeball-inactiva.svg"
                        alt="Ir a <%= numeroPokedex(v.pokemon.id) %> <%= v.pokemon.nombre %>" width="32"
                        height="32"></a>
                  </li>
                  <% } %>
                    <% }) %>
          </ul>
        </nav>

        <p class="volver"><a href="/">&larr; Volver a la lista</a></p>

        <article id="ficha-pokemon">
          <h1><span>
              <%= numeroPokedex(pokemon.id) %>
            </span>
            <%= pokemon.nombre %>
          </h1>

          <nav id="indice-ficha">
            <ul>
              <li><a href="#detalles">Detalles</a></li>
              <li><a href="#habilidades">Habilidades</a></li>
              <li><a href="#estadisticas">Estadísticas</a></li>
              <li><a href="#mas-informacion">Más información</a></li>
            </ul>
          </nav>

          <p>
            <%= pokemon.descripcion %>
          </p>

          <div class="ficha-pokemon__resumen">
            <figure class="ficha-pokemon__imagen">
              <img src="/assets/<%= pokemon.slug %>.png"
                alt="<%= pokemon.nombre %>, un Pokémon de tipo <%= pokemon.tipos.join(' y ') %>" width="300"
                height="300">
              <figcaption>
                <%= pokemon.nombre %>, el <%= pokemon.genus %>
              </figcaption>
            </figure>

            <section id="detalles" class="ficha-pokemon__detalles">
              <h2>Detalles</h2>
              <dl>
                <dt>Peso</dt>
                <dd>
                  <%= pokemon.peso.toFixed(1) %> kg
                </dd>
                <dt>Tamaño</dt>
                <dd>
                  <%= pokemon.tamano.toFixed(1) %> m
                </dd>
                <dt>Tipo</dt>
                <dd>
                  <% pokemon.tipos.forEach((t)=> { %><span class="tipo tipo--<%= t %>">
                      <%= mayus(t) %>
                    </span>
                    <% }) %>
                </dd>
              </dl>
              <h3>Cadena evolutiva</h3>
              <ol class="cadena-evolutiva">
                <% pokemon.evolucion.forEach((n)=> { %>
                  <% if (n===pokemon.nombre) { %>
                    <li class="cadena-evolutiva__actual" aria-current="true">
                      <%= n %>
                    </li>
                    <% } else { %>
                      <li>
                        <%= n %>
                      </li>
                      <% } %>
                        <% }) %>
              </ol>
            </section>

            <section id="habilidades" class="ficha-pokemon__habilidades">
              <h2>Habilidades</h2>
              <dl>
                <% pokemon.habilidades.forEach((h)=> { %>
                  <dt>
                    <%= h.nombre %>
                      <% if (h.oculta) { %> <em>(oculta)</em>
                        <% } %>
                  </dt>
                  <dd>
                    <%= h.descripcion %>
                  </dd>
                  <% }) %>
              </dl>
            </section>
          </div>

          <section id="estadisticas">
            <h2>Estadísticas</h2>
            <table class="stats-table">
              <caption>Estadísticas base de <%= pokemon.nombre %>
              </caption>
              <thead>
                <tr>
                  <th abbr="PS">Puntos de Salud</th>
                  <th abbr="ATQ">Ataque</th>
                  <th abbr="DEF">Defensa</th>
                  <th abbr="AT. ESP.">Ataque Especial</th>
                  <th abbr="DEF. ESP.">Defensa Especial</th>
                  <th abbr="VEL">Velocidad</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <% Object.values(pokemon.stats).forEach((v)=> { %><td style="--valor: <%= v %>">
                      <%= v %>
                    </td>
                    <% }) %>
                </tr>
              </tbody>
              <tfoot>
                <tr class="stats-table__total">
                  <td colspan="6">Total: <%= totalStats(pokemon) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </section>

          <section id="mas-informacion">
            <h2>Más información</h2>
            <h3>¿Cómo se leen estas estadísticas?</h3>
            <p>Cada número de la tabla es un valor base, en una escala que en la práctica va de 5 a 255. <%= lectura %>
            </p>
            <h3>¿Qué es una habilidad oculta?</h3>
            <p>Es una habilidad que el Pokémon puede tener en lugar de la habitual, pero que no aparece por métodos
              normales de captura. En la ficha la marcamos con la palabra <em>oculta</em> entre paréntesis.</p>
            <h3>¿De dónde salieron estos datos?</h3>
            <p>Las ilustraciones vienen del repositorio público de PokeAPI y los datos de la misma PokeAPI. Los enlaces
              completos están en el pie de esta página.</p>
          </section>

          <p><a href="https://bulbapedia.bulbagarden.net/wiki/<%= pokemon.nombre %>_(Pokémon)" target="_blank"
              rel="noopener">Ver ficha completa en Bulbapedia</a> (se abre en una pestaña nueva)</p>
        </article>
    </main>

    <%- include('parciales/footer') %>